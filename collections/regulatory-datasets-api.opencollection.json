{
  "opencollection": "1.0.0",
  "info": {
    "name": "FINRA Developer Center Async Datasets API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Datasets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List datasets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.finra.org/datasets"
          },
          "docs": "Returns a comprehensive list of all Query API datasets."
        }
      ]
    }
  ],
  "bundled": true
}