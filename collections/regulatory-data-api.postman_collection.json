  "info": {
    "_postman_id": "5947e30b-8871-4390-a7c8-08a44435781d",
    "name": "FINRA Developer Center Async Data API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The FINRA (Financial Industry Regulatory Authority) Developer Center exposes\na REST Query API for accessing market data, regulatory datasets, and related\nmetadata. The Query API provides dataset metadata, partition information,\nrecord-level retrieval, and asynchronous query support across organized\ngroups and named datasets.\n\nContact Support:\n Name: FINRA Developer Center",
      "type": "text/plain"
    }
  }
